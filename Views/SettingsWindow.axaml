<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyDesktopLyrics.ViewModels"
        xmlns:views="using:EasyDesktopLyrics.Views"
        x:Class="EasyDesktopLyrics.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="EasyDesktopLyrics 设置"
        Width="780" Height="740" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,Blur"
        Background="Transparent">

  <Window.Styles>
    <!-- 卡片：半透明深色分层（透过云母），WinUI 3 圆角语言 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#F01F1F1F" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.cardDesc">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Separator">
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <!-- 侧边导航：NavigationView 风格胶囊高亮（无 Fluent 动画），
         :selected 定义在 :pointerover 之后，同优先级下后者优先，hover 不覆盖选中高亮 -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Background="{TemplateBinding Background}"
                              CornerRadius="6"
                              Padding="10,8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="8,1,12,1" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover">
      <Setter Property="Background" Value="#12FFFFFF" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="196,*">
    <!-- 侧边导航（半透明，透出云母） -->
    <Border Grid.Column="0" Background="#E61F1F1F"
            BorderBrush="#26FFFFFF"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,18,16,12">
          <TextBlock Text="EasyDesktopLyrics" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="设置" FontSize="12" Opacity="0.6" />
        </StackPanel>
        <ListBox Classes="nav" Margin="0,2,0,12"
                 ItemsSource="{Binding NavOptions}"
                 SelectedIndex="{Binding SelectedNav, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavOption">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 内容区：Padding 改为内容 Margin（Margin 计入 Extent，滚动范围完整） -->
    <ScrollViewer x:Name="ContentScroll" Grid.Column="1"
                  Background="Transparent"
                  HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="ContentHost" Margin="16,14,16,4" />
    </ScrollViewer>
  </Grid>

</Window>

