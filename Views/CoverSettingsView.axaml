<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyDesktopLyrics.ViewModels"
             xmlns:local="using:EasyDesktopLyrics.Views"
             x:Class="EasyDesktopLyrics.Views.CoverSettingsView"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="12">
    <!-- 歌词封面 -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="歌词封面" />
          <TextBlock Classes="cardDesc"
                     Text="点击播放控制条中的上一首/下一首时，封面平滑淡入居中展示，之后移动到常驻位置（若开启常驻）或按方向淡出。封面为正方形，边长不超过歌词行高度的 120%。" />
        </StackPanel>
        <Grid ColumnDefinitions="110,*,64" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Classes="sectionLabel" Text="常驻显示" />
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding CoverEnabled, Mode=TwoWay}" />
          <TextBlock Classes="sectionLabel" Text="切歌动画" Grid.Row="1" />
          <ToggleSwitch Grid.Column="1" Grid.Row="1" IsChecked="{Binding CoverCutAnimation, Mode=TwoWay}" />
          <TextBlock Classes="sectionLabel" Text="封面占比" Grid.Row="2" />
          <Slider Grid.Column="1" Grid.Row="2" Minimum="40" Maximum="120" TickFrequency="5"
                  Value="{Binding CoverSizePctVal, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Grid.Row="2" MinHeight="28" Padding="8,2" Text="{Binding CoverSizePctVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}%'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Classes="sectionLabel" Text="最短显示" Grid.Row="3" />
          <Slider Grid.Column="1" Grid.Row="3" Minimum="0.3" Maximum="5" TickFrequency="0.1"
                  Value="{Binding CoverAnimMinSec, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Grid.Row="3" MinHeight="28" Padding="8,2" Text="{Binding CoverAnimMinSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}s'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Classes="sectionLabel" Text="最长显示" Grid.Row="4" />
          <Slider Grid.Column="1" Grid.Row="4" Minimum="1" Maximum="15" TickFrequency="0.5"
                  Value="{Binding CoverAnimMaxSec, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Grid.Row="4" MinHeight="28" Padding="8,2" Text="{Binding CoverAnimMaxSec, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}s'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Classes="sectionLabel" Text="缓动曲线" Grid.Row="5" />
          <ComboBox Grid.Column="1" Grid.Row="5" ItemsSource="{Binding CoverAnimEasingOptions}"
                    SelectedIndex="{Binding CoverAnimEasingIndex, Mode=TwoWay}" Width="160"
                    HorizontalAlignment="Left" />
          <TextBlock Classes="sectionLabel" Text="动画时长" Grid.Row="6" />
          <Slider Grid.Column="1" Grid.Row="6" Minimum="0.1" Maximum="2" TickFrequency="0.05"
                  Value="{Binding CoverAnimDurationVal, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Grid.Row="6" MinHeight="28" Padding="8,2" Text="{Binding CoverAnimDurationVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}s'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          <TextBlock Classes="sectionLabel" Text="淡入淡出方向" Grid.Row="7" />
          <ComboBox Grid.Column="1" Grid.Row="7" ItemsSource="{Binding CoverAnimDirectionOptions}"
                    SelectedIndex="{Binding CoverAnimDirectionIndex, Mode=TwoWay}" Width="160"
                    HorizontalAlignment="Left" />
          <TextBlock Classes="sectionLabel" Text="位移强度" Grid.Row="8" />
          <Slider Grid.Column="1" Grid.Row="8" Minimum="0" Maximum="60" TickFrequency="1"
                  Value="{Binding CoverAnimSlideDistanceVal, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Grid.Row="8" MinHeight="28" Padding="8,2" Text="{Binding CoverAnimSlideDistanceVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}px'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
        </Grid>

        <!-- 切歌歌名 -->
        <StackPanel Spacing="6">
          <CheckBox Content="切歌时显示歌名" IsChecked="{Binding CoverTitleEnabled, Mode=TwoWay}" />
          <Border IsVisible="{Binding CoverTitleEnabled}" Margin="20,0,0,0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="显示歌手" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CoverTitleShowArtist, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="淡入淡出方向" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CoverTitleAnimDirectionOptions}"
                          SelectedIndex="{Binding CoverTitleAnimDirectionIndex, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                <TextBlock Classes="sectionLabel" Text="位移强度" />
                <Slider Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="1"
                        Value="{Binding CoverTitleSlideDistanceVal, Mode=TwoWay}" />
                <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                         Text="{Binding CoverTitleSlideDistanceVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}px'}"
                         TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
              </Grid>
              <TextBlock Text="歌名与歌手分行显示，位于封面下方，随切歌动画淡入淡出；样式独立可调。" FontSize="11" Opacity="0.6" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 歌名样式 -->
        <StackPanel Spacing="6">
          <TextBlock Text="歌名样式" FontWeight="SemiBold" FontSize="13" IsVisible="{Binding CoverTitleEnabled}" />
          <Border IsVisible="{Binding CoverTitleEnabled}" Margin="20,0,0,0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="字体" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontOptions}"
                          SelectedItem="{Binding CoverTitleFont, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="颜色" />
                <local:ColorPicker Grid.Column="1" Color="{Binding CoverTitleColorValue, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                <TextBlock Classes="sectionLabel" Text="字号" />
                <Slider Grid.Column="1" Minimum="10" Maximum="60" TickFrequency="1"
                        Value="{Binding CoverTitleFontSizeVal, Mode=TwoWay}" />
                <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                         Text="{Binding CoverTitleFontSizeVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                         TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
              </Grid>
              <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                <TextBlock Classes="sectionLabel" Text="不透明度" />
                <Slider Grid.Column="1" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                        Value="{Binding CoverTitleOpacityVal, Mode=TwoWay}" />
                <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                         Text="{Binding CoverTitleOpacityVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:P0}'}"
                         TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
              </Grid>
              <StackPanel Spacing="6">
                <CheckBox Content="歌名描边" IsChecked="{Binding CoverTitleStrokeEnabled, Mode=TwoWay}" />
                <Border IsVisible="{Binding CoverTitleStrokeEnabled}" Margin="16,0,0,0">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                      <TextBlock Classes="sectionLabel" Text="描边颜色" />
                      <local:ColorPicker Grid.Column="1" Color="{Binding CoverTitleStrokeColorValue, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="描边宽度" />
                      <Slider Grid.Column="1" Minimum="0.1" Maximum="4" TickFrequency="0.1"
                              Value="{Binding CoverTitleStrokeThicknessVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverTitleStrokeThicknessVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Spacing="6">
                <CheckBox Content="歌名阴影" IsChecked="{Binding CoverTitleShadowEnabled, Mode=TwoWay}" />
                <Border IsVisible="{Binding CoverTitleShadowEnabled}" Margin="16,0,0,0">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                      <TextBlock Classes="sectionLabel" Text="阴影颜色" />
                      <local:ColorPicker Grid.Column="1" Color="{Binding CoverTitleShadowColorValue, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="模糊半径" />
                      <Slider Grid.Column="1" Minimum="1" Maximum="40" TickFrequency="1"
                              Value="{Binding CoverTitleShadowBlurVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverTitleShadowBlurVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="垂直偏移" />
                      <Slider Grid.Column="1" Minimum="-20" Maximum="20" TickFrequency="1"
                              Value="{Binding CoverTitleShadowOffsetYVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverTitleShadowOffsetYVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 歌手样式 -->
        <StackPanel Spacing="6">
          <TextBlock Text="歌手样式" FontWeight="SemiBold" FontSize="13" IsVisible="{Binding CoverTitleShowArtist}" />
          <Border IsVisible="{Binding CoverTitleShowArtist}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="字体" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding FontOptions}"
                          SelectedItem="{Binding CoverArtistFont, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                <TextBlock Classes="sectionLabel" Text="颜色" />
                <local:ColorPicker Grid.Column="1" Color="{Binding CoverArtistColorValue, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                <TextBlock Classes="sectionLabel" Text="字号" />
                <Slider Grid.Column="1" Minimum="10" Maximum="60" TickFrequency="1"
                        Value="{Binding CoverArtistFontSizeVal, Mode=TwoWay}" />
                <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                         Text="{Binding CoverArtistFontSizeVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                         TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
              </Grid>
              <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                <TextBlock Classes="sectionLabel" Text="不透明度" />
                <Slider Grid.Column="1" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                        Value="{Binding CoverArtistOpacityVal, Mode=TwoWay}" />
                <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                         Text="{Binding CoverArtistOpacityVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:P0}'}"
                         TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
              </Grid>
              <StackPanel Spacing="6">
                <CheckBox Content="歌手描边" IsChecked="{Binding CoverArtistStrokeEnabled, Mode=TwoWay}" />
                <Border IsVisible="{Binding CoverArtistStrokeEnabled}" Margin="16,0,0,0">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                      <TextBlock Classes="sectionLabel" Text="描边颜色" />
                      <local:ColorPicker Grid.Column="1" Color="{Binding CoverArtistStrokeColorValue, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="描边宽度" />
                      <Slider Grid.Column="1" Minimum="0.1" Maximum="4" TickFrequency="0.1"
                              Value="{Binding CoverArtistStrokeThicknessVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverArtistStrokeThicknessVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Spacing="6">
                <CheckBox Content="歌手阴影" IsChecked="{Binding CoverArtistShadowEnabled, Mode=TwoWay}" />
                <Border IsVisible="{Binding CoverArtistShadowEnabled}" Margin="16,0,0,0">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                      <TextBlock Classes="sectionLabel" Text="阴影颜色" />
                      <local:ColorPicker Grid.Column="1" Color="{Binding CoverArtistShadowColorValue, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="模糊半径" />
                      <Slider Grid.Column="1" Minimum="1" Maximum="40" TickFrequency="1"
                              Value="{Binding CoverArtistShadowBlurVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverArtistShadowBlurVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,64" ColumnSpacing="14">
                      <TextBlock Classes="sectionLabel" Text="垂直偏移" />
                      <Slider Grid.Column="1" Minimum="-20" Maximum="20" TickFrequency="1"
                              Value="{Binding CoverArtistShadowOffsetYVal, Mode=TwoWay}" />
                      <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                               Text="{Binding CoverArtistShadowOffsetYVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="歌名与歌手分行显示，样式独立；歌手行随“显示歌手”开关显示。" FontSize="11" Opacity="0.6" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
