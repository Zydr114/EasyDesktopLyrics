<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyDesktopLyrics.ViewModels"
        xmlns:views="using:EasyDesktopLyrics.Views"
        x:Class="EasyDesktopLyrics.Views.LyricsOverlayWindow"
        x:DataType="vm:OverlayViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Width">

  <Border CornerRadius="6" Padding="12,6">
    <Grid x:Name="FxRoot">
      <!-- 背景动效层（频谱/飘雪/雾层）：由代码后置插入到最底层，纯视觉、不拦截鼠标 -->
      <Grid x:Name="OuterGrid" RowDefinitions="Auto,Auto">
      <!-- 常驻布局：封面占位列 + 歌词列 + 对称占位列（歌词始终居中） -->
      <Grid x:Name="MainGrid" Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto">
        <Border x:Name="CoverSlot" Grid.Column="0" Width="0" Height="0"
                VerticalAlignment="Top" />
        <Grid x:Name="LyricsArea" Grid.Column="1">
          <Viewbox x:Name="LyricsViewbox" MaxWidth="{Binding MaxTextWidth}"
                   StretchDirection="DownOnly">
          <Viewbox.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="QuadraticEaseOut" />
            </Transitions>
          </Viewbox.Transitions>
            <StackPanel x:Name="RootPanel" Spacing="{Binding LineSpacing}">
              <!-- 内容由代码后置动态构建，支持描边/辉光层切换 -->
            </StackPanel>
          </Viewbox>
        </Grid>
        <Border x:Name="RightPad" Grid.Column="2" Width="0" Height="0"
                VerticalAlignment="Top" />
      </Grid>

      <!-- 封面覆盖层：RenderTransform 定位（常驻位 / 窗口中心）。纯封面图像，圆角完整。 -->
      <Border x:Name="Cover" HorizontalAlignment="Left" VerticalAlignment="Top"
              CornerRadius="8" ClipToBounds="True"
              IsHitTestVisible="False" Opacity="0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="QuadraticEaseOut" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="QuadraticEaseOut" />
          </Transitions>
        </Border.Transitions>
        <Image x:Name="CoverImage" Stretch="UniformToFill">
          <Image.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.45" Easing="QuadraticEaseOut" />
              <DoubleTransition Property="Height" Duration="0:0:0.45" Easing="QuadraticEaseOut" />
            </Transitions>
          </Image.Transitions>
        </Image>
      </Border>

      <!-- 歌名/歌手独立覆盖层：切歌动画期间在封面下方显示，淡入淡出、不跟随封面动画路径 -->
      <Viewbox x:Name="CoverTitleBox" MaxWidth="{Binding MaxTextWidth}" StretchDirection="DownOnly"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               IsHitTestVisible="False" IsVisible="False" Opacity="0">
        <Viewbox.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="QuadraticEaseOut" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="QuadraticEaseOut" />
          </Transitions>
        </Viewbox.Transitions>
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <views:LyricText x:Name="CoverTitleText" Text="{Binding CoverTitle}"
                           HorizontalAlignment="Center"
                           FontFamily="{Binding CoverTitleFontFamily}"
                           FontSize="{Binding CoverTitleFontSize}"
                           Fill="{Binding CoverTitleColor}"
                           Opacity="{Binding CoverTitleOpacity}"
                           StrokeEnabled="{Binding CoverTitleStrokeEnabled}"
                           StrokeBrush="{Binding CoverTitleStrokeBrush}"
                           StrokeThickness="{Binding CoverTitleStrokeThickness}"
                           Effect="{Binding CoverTitleShadowEffect}" />
          <views:LyricText x:Name="CoverArtistText" Text="{Binding CoverArtist}"
                           HorizontalAlignment="Center"
                           FontFamily="{Binding CoverArtistFontFamily}"
                           FontSize="{Binding CoverArtistFontSize}"
                           Fill="{Binding CoverArtistColor}"
                           Opacity="{Binding CoverArtistOpacity}"
                           StrokeEnabled="{Binding CoverArtistStrokeEnabled}"
                           StrokeBrush="{Binding CoverArtistStrokeBrush}"
                           StrokeThickness="{Binding CoverArtistStrokeThickness}"
                           Effect="{Binding CoverArtistShadowEffect}"
                           IsVisible="{Binding CoverTitleShowArtist}" />
        </StackPanel>
      </Viewbox>

      <!-- 播放控制条：hover 显示，位于所有内容（封面/歌词）下方 -->
      <Border x:Name="ControlBar" Grid.Row="1"
              Height="0" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Height" Duration="0:0:0.15" />
            <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
          </Transitions>
        </Border.Transitions>
        <Border Margin="0,4,0,0" Height="30" HorizontalAlignment="Center"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                CornerRadius="14" Padding="6,2">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Command="{Binding PrevCommand}" Background="Transparent" BorderThickness="0"
                    Padding="10,3" CornerRadius="10" HorizontalContentAlignment="Center">
              <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                         FontSize="13" />
            </Button>
            <Button Command="{Binding PlayPauseCommand}" Background="Transparent" BorderThickness="0"
                    Padding="10,3" CornerRadius="10" HorizontalContentAlignment="Center">
              <TextBlock x:Name="PlayPauseIcon" Text="&#xE769;"
                         FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="13" />
            </Button>
            <Button Command="{Binding NextCommand}" Background="Transparent" BorderThickness="0"
                    Padding="10,3" CornerRadius="10" HorizontalContentAlignment="Center">
              <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                         FontSize="13" />
            </Button>
          </StackPanel>
        </Border>
      </Border>
      </Grid>
    </Grid>
  </Border>

</Window>
