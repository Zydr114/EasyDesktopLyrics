<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyDesktopLyrics.ViewModels"
             xmlns:local="using:EasyDesktopLyrics.Views"
             x:Class="EasyDesktopLyrics.Views.AppearanceSettingsView"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="12">
    <!-- 字体 -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="字体" />
          <TextBlock Classes="cardDesc" Text="歌词正文与翻译行使用的字体。" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding FontOptions}"
                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}" />
        <Border Padding="10,6" Background="{DynamicResource SystemAltHighColor}" CornerRadius="6">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding FontPreviewText}"
                       FontFamily="{Binding SelectedFontFamily}"
                       FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedFont}" FontSize="11" Opacity="0.6" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- 文字 -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="文字" />
          <TextBlock Classes="cardDesc" Text="歌词颜色、字号与字重。" />
        </StackPanel>
        <Grid ColumnDefinitions="120,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Classes="sectionLabel" Text="颜色" />
          <local:ColorPicker Grid.Column="1" Color="{Binding ColorValue, Mode=TwoWay}" />
          <TextBlock Classes="sectionLabel" Text="字号 / 字重" Grid.Row="1" />
          <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Grid ColumnDefinitions="*,64">
              <Slider Minimum="10" Maximum="120" TickFrequency="1"
                      Value="{Binding FontSize, Mode=TwoWay}" />
              <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                       Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                       TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <ComboBox Grid.Column="1" ItemsSource="{Binding WeightOptions}"
                      SelectedIndex="{Binding WeightIndex, Mode=TwoWay}" />
          </Grid>
        </Grid>
        <StackPanel Spacing="6">
          <CheckBox Content="独立设置未唱颜色（逐字模式）" IsChecked="{Binding InactiveColorIndependent, Mode=TwoWay}" />
          <Border IsVisible="{Binding InactiveColorIndependent}" Margin="20,0,0,0">
            <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
              <TextBlock Classes="sectionLabel" Text="未唱颜色" />
              <local:ColorPicker Grid.Column="1" Color="{Binding InactiveColorValue, Mode=TwoWay}" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="120,*,64" ColumnSpacing="14" Margin="20,0,0,0">
            <TextBlock Classes="sectionLabel" Text="未唱不透明度" />
            <Slider Grid.Column="1" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                    Value="{Binding InactiveOpacityVal, Mode=TwoWay}" />
            <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                     Text="{Binding InactiveOpacityVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F2}'}"
                     TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </Grid>
          <TextBlock Text="未唱不透明度为相对比例：100% 时未唱段与已唱段等亮。独立颜色不勾选时，该比例同时控制未唱段亮度。" FontSize="11" Opacity="0.6" />
        </StackPanel>
        <Grid ColumnDefinitions="120,*" ColumnSpacing="14">
          <TextBlock Classes="sectionLabel" Text="翻译字号" />
          <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="14">
            <Slider Minimum="0" Maximum="80" TickFrequency="1"
                    Value="{Binding TransFontSizeVal, Mode=TwoWay}" />
            <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                     Text="{Binding TransFontSizeVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                     TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </Grid>
        <TextBlock Text="翻译字号为 0 时自动取正文字号的 60%。" FontSize="11" Opacity="0.6" />
      </StackPanel>
    </Border>

    <!-- 显示效果 -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="显示效果" />
          <TextBlock Classes="cardDesc" Text="歌词整体透明度与单行最大宽度。" />
        </StackPanel>
        <Grid ColumnDefinitions="110,*,64" ColumnSpacing="14">
          <TextBlock Classes="sectionLabel" Text="整体不透明度" />
          <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="14">
            <Slider Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    Value="{Binding TextOpacity, Mode=TwoWay}" />
            <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                     Text="{Binding TextOpacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F2}'}"
                     TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </Grid>
        <Grid ColumnDefinitions="110,*,64" ColumnSpacing="14">
          <TextBlock Classes="sectionLabel" Text="最大宽度" />
          <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="14">
            <Slider Minimum="200" Maximum="2000" TickFrequency="50"
                    Value="{Binding MaxWidth, Mode=TwoWay}" />
            <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                     Text="{Binding MaxWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                     TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </Grid>
        <TextBlock Text="超过最大宽度的歌词行会自动等比缩小。最大宽度单位：DIP。" FontSize="11" Opacity="0.6" />
      </StackPanel>
    </Border>

    <!-- 位置 -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="歌词位置" />
          <TextBlock Classes="cardDesc"
                     Text="点击九宫格快速定位，或用滑块精细调节。解锁状态下也可直接拖动歌词窗口。" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
          <!-- 九宫格（左） -->
          <StackPanel HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding PositionPresets}" MaxWidth="124">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Width="36" Height="30" Margin="2" Padding="0"
                          Command="{Binding $parent[ItemsControl].DataContext.SnapPresetCommand}"
                          CommandParameter="{Binding Preset, StringFormat='{}{0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- 精细调节（右） -->
          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
            <Grid ColumnDefinitions="50,*,64" ColumnSpacing="14">
              <TextBlock Classes="sectionLabel" Text="水平" />
              <Slider Grid.Column="1" Minimum="5" Maximum="95" TickFrequency="1"
                      Value="{Binding PositionXPct, Mode=TwoWay}" />
              <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                       Text="{Binding PositionXPct, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                       TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="50,*,64" ColumnSpacing="14">
              <TextBlock Classes="sectionLabel" Text="垂直" />
              <Slider Grid.Column="1" Minimum="5" Maximum="95" TickFrequency="1"
                      Value="{Binding PositionYPct, Mode=TwoWay}" />
              <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                       Text="{Binding PositionYPct, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                       TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="14">
              <TextBlock Classes="sectionLabel" Text="高度扩展" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding HeightGrowOptions}"
                        SelectedIndex="{Binding HeightGrowIndex, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="窗口高度变化（胶囊展开/封面动画/翻译行等）时的扩展方向。" FontSize="11" Opacity="0.6" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
